# Copy this file to .env and fill in the values.
# .env is gitignored; this file is the tracked template.
#
# Read by Settings in config.py (pydantic-settings). Names are matched
# case-insensitively, so SECRET_KEY here fills the secret_key field.

# Required. The database SQLAlchemy and Alembic both connect to.
# Create it first with `createdb blog`, then run `alembic upgrade head`.
DATABASE_URL=postgresql+psycopg://user:password@localhost/blog

# Required. The S3 bucket avatars are uploaded to. Create the bucket in AWS
# first and apply the policies in aws_bucket_policy.json and aws_iam_policy.json
# -- see "Setting up S3" in the README. Verify with `python check_s3.py`.
S3_BUCKET_NAME=
S3_REGION=us-east-1

# Required. Signs and verifies the JWT access tokens, so changing it
# invalidates every token already issued. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Everything below is optional and falls back to the default shown,
# so you only need these to override.

# JWT signing algorithm.
# ALGORITHM=HS256

# How long an access token stays valid, in minutes.
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# Largest avatar upload accepted, in bytes. Default is 5MB.
# MAX_UPLOAD_SIZE_BYTES=5242880

# Posts rendered on a page before the Load More button appears.
# POSTS_PER_PAGE=10

# How long a password reset link stays valid, in minutes.
# RESET_TOKEN_EXPIRE_MINUTES=60

# Outgoing mail, used for password reset messages. The defaults point at a
# local SMTP server; run MailHog or `python -m aiosmtpd -n -l localhost:587`
# to catch them in development.
# MAIL_SERVER=localhost
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=noreply@example.com
# MAIL_USE_TLS=true

# Base URL used to build the reset link inside the email.
# FRONTEND_URL=http://localhost:8000

# S3 credentials. Leave both unset to let boto3 use its standard sources
# (~/.aws/credentials, AWS_* environment variables, or an instance role in
# production, which avoids long-lived keys).
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Point at an S3-compatible service such as MinIO or LocalStack instead of AWS.
# Leave unset for real S3.
# S3_ENDPOINT_URL=
